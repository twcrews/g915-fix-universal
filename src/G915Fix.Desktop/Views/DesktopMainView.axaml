<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="G915Fix.Desktop.Views.DesktopMainView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16" MaxWidth="760">
      <Border Classes="permission-warning" IsVisible="{Binding HasMissingPermissions}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
          <TextBlock Text="{Binding MissingPermissionsMessage}" TextWrapping="Wrap" VerticalAlignment="Center" />
          <Button Grid.Column="1" Content="Open Permissions" Command="{Binding OpenPermissionsCommand}" />
        </Grid>
      </Border>

      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding ApplicationName}" Classes="title" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText, StringFormat=Version {0}}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Runtime.Status, StringFormat=Input filtering: {0}}" Classes="status" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Filtering" Classes="section-title" />
          <Grid ColumnDefinitions="Auto,Auto,*,Auto,*" ColumnSpacing="12">
            <ToggleSwitch Content="Enable keyboard filtering" IsChecked="{Binding KeyboardEnabled}" IsEnabled="{Binding CanToggleInputFiltering}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Mode" VerticalAlignment="Center" />
            <ComboBox Grid.Column="2" ItemsSource="{Binding KeyboardModes}" SelectedItem="{Binding KeyboardMode}" />
            <TextBlock Grid.Column="3" Text="Minimum repeat interval (ms)" VerticalAlignment="Center" />
            <TextBox Grid.Column="4" Text="{Binding KeyboardMinimumRepeatIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
          <Grid ColumnDefinitions="Auto,Auto,*" ColumnSpacing="12">
            <ToggleSwitch Content="Enable mouse filtering" IsChecked="{Binding MouseEnabled}" IsEnabled="{Binding CanToggleInputFiltering}" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="Mouse repeat interval (ms)" VerticalAlignment="Center" />
            <TextBox Grid.Column="2" Text="{Binding MouseMinimumRepeatIntervalMs, UpdateSourceTrigger=PropertyChanged}" />
          </Grid>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Profiles" Classes="section-title" />
          <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <ToggleSwitch Content="Auto-switch profiles for games" IsChecked="{Binding AutoSwitchProfiles}" />
          <Button Content="Update games list..." Command="{Binding UpdateGamesListCommand}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Application" Classes="section-title" />
          <ToggleSwitch Content="Write diagnostic events" IsChecked="{Binding DiagnosticsEnabled}" IsEnabled="{Binding CanToggleDiagnostics}" />
          <Button Content="Open diagnostic heatmap" Command="{Binding OpenHeatmapCommand}" />
          <TextBlock Text="{Binding Message}" Classes="status" TextWrapping="Wrap" />
          <ToggleSwitch Content="Check for updates" IsChecked="{Binding CheckForUpdates}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleSwitch Content="Start at login" IsChecked="{Binding AutostartEnabled}" IsEnabled="{Binding CanToggleAutostart}" />
            <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Autostart.Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UpdateResult.Message}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding ConfigurationWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Message}" Classes="warning" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="status" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
