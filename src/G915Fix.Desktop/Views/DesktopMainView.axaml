<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="G915Fix.Desktop.Views.DesktopMainView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16" MaxWidth="760">
      <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
        <TextBlock Text="{Binding ApplicationName}" Classes="title" />
        <TextBlock Grid.Column="1" Text="{Binding VersionText, StringFormat=Version {0}}" VerticalAlignment="Center" />
        <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding Runtime.Status, StringFormat=Input filtering: {0}}" Classes="status" />
      </Grid>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Filtering" Classes="section-title" />
          <ToggleSwitch Content="Enable keyboard filtering" IsChecked="{Binding KeyboardEnabled}" />
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
            <TextBlock Text="Mode" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding KeyboardModes}" SelectedItem="{Binding KeyboardMode}" />
            <TextBlock Grid.Row="1" Text="Minimum repeat interval (ms)" VerticalAlignment="Center" />
            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding KeyboardMinimumRepeatIntervalMs}" />
          </Grid>
          <ToggleSwitch Content="Enable mouse click debounce" IsChecked="{Binding MouseEnabled}" />
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
            <TextBlock Text="Mouse repeat interval (ms)" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding MouseMinimumRepeatIntervalMs}" />
          </Grid>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Start" Command="{Binding StartCommand}" />
            <Button Content="Stop" Command="{Binding StopCommand}" />
            <Button Content="Save and apply" Command="{Binding SaveCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="12">
          <TextBlock Text="Profiles" Classes="section-title" />
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
            <ComboBox ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}">
              <ComboBox.ItemTemplate>
                <DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <Button Grid.Column="1" Content="Activate" Command="{Binding ActivateProfileCommand}" />
          </Grid>
          <ToggleSwitch Content="Auto-switch profiles for games" IsChecked="{Binding AutoSwitchProfiles}" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="10">
          <TextBlock Text="Application" Classes="section-title" />
          <ToggleSwitch Content="Write diagnostic events" IsChecked="{Binding DiagnosticsEnabled}" />
          <Button Content="Open diagnostic heatmap" Command="{Binding OpenHeatmapCommand}" />
          <ToggleSwitch Content="Check for updates" IsChecked="{Binding CheckForUpdates}" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Initialize" Command="{Binding InitializeCommand}" />
            <Button Content="Toggle autostart" Command="{Binding ToggleAutostartCommand}" />
            <Button Content="Check now" Command="{Binding CheckForUpdatesCommand}" />
          </StackPanel>
          <TextBlock Text="{Binding Autostart.Message}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding UpdateResult.Message}" TextWrapping="Wrap" />
        </StackPanel>
      </Border>

      <Border Classes="card">
        <StackPanel Spacing="8">
          <TextBlock Text="Permissions" Classes="section-title" />
          <ComboBox ItemsSource="{Binding Permissions}" SelectedItem="{Binding SelectedPermission}">
            <ComboBox.ItemTemplate>
              <DataTemplate><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>
          <TextBlock Text="{Binding SelectedPermission.Message}" TextWrapping="Wrap" />
          <Button Content="Grant permission / open settings" Command="{Binding RequestPermissionCommand}" />
        </StackPanel>
      </Border>

      <ItemsControl ItemsSource="{Binding ConfigurationWarnings}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <TextBlock Text="{Binding Message}" Classes="warning" TextWrapping="Wrap" />
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>

      <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Classes="status" />
    </StackPanel>
  </ScrollViewer>
</UserControl>
