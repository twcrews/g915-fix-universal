<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="G915Fix.MacOS.PermissionsWindow"
        Title="Permissions Required"
        Width="440"
        Height="300"
        MinWidth="360"
        MinHeight="220"
        CanResize="False"
        WindowStartupLocation="CenterScreen">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled">
    <StackPanel Margin="24" Spacing="16">
      <TextBlock Text="Permissions Required" Classes="title" />
      <TextBlock Text="The G915 Fix app requires the following permissions to work properly."
                 TextWrapping="Wrap" />
      <ItemsControl ItemsSource="{Binding Permissions}">
        <ItemsControl.ItemTemplate>
          <DataTemplate>
            <Button Classes="permission" Command="{Binding RequestCommand}" IsEnabled="{Binding NeedsPermission}">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding StatusText}" FontSize="12" Opacity="0.7" />
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <TextBlock Text="{Binding Message}" Classes="status" TextWrapping="Wrap" />
    </StackPanel>
  </ScrollViewer>
</Window>
