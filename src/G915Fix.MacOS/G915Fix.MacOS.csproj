<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <UseAppHost>true</UseAppHost>
    <AssemblyName>G915Fix.MacOS</AssemblyName>
    <RootNamespace>G915Fix.MacOS</RootNamespace>
    <RuntimeIdentifiers>osx-arm64;osx-x64</RuntimeIdentifiers>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../G915Fix.Core/G915Fix.Core.csproj" />
    <ProjectReference Include="../G915Fix.Desktop/G915Fix.Desktop.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="11.3.20" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="../../res/app-icon-black.png" Link="Assets/app-icon-black.png" />
    <AvaloniaResource Include="../../res/app-icon-white.png" Link="Assets/app-icon-white.png" />
    <!-- Keep the authored macOS Icon Composer asset with the host for bundle packaging. -->
    <None Include="../../res/app-icon.icon/**" Link="Assets/app-icon.icon/%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
